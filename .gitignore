# Local Serena MCP project state
.serena/

# Dependencies and generated caches
node_modules/
.instinct-digest-state.json
antigravity-*
.DS_Store
opencode-fallback.log
warp-rotate/auto-fallback-watch*.*

# Python cache
**/__pycache__/

# Local environment files
.env
.env.*
!.env.example

# Local-only runtime state
logs/
profiles/
opencode.bkup/
*.bkup/
*.bku
*.tui-migration.bak

# Local agents (not synced)
/agents/

# Plugin-installed skill (regenerated on opencode start)
skills/skill-creator/
opencode-skill-creator-update-check.json
skills/opencode-skill-creator/*

# /learn output (drafts + promoted learned skills)
skills/learned/*.draft.md
skills/learned/learned-*.md

